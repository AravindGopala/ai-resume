# copy this file to .env and fill in the values
#
# This branch builds a static site for GitHub Pages, so there is no server:
# the contact form, Resend, Firebase and reCAPTCHA are not used here. See the
# `main` branch for the full-featured (Vercel) build.

## Site URL — used for SEO (sitemap, robots, og tags).
## The Pages workflow sets this automatically; only needed for local builds.
# NEXT_PUBLIC_SITE_URL="https://aravindgopala.github.io/ai-resume"

## Path prefix the site is served under. Empty for a user/org page,
## "/<repo>" for a project page. The Pages workflow derives this automatically.
# NEXT_PUBLIC_BASE_PATH="/ai-resume"

## Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="{{YOUR_GA_MEASUREMENT_ID}}"

## Context7 (MCP — optional, higher rate limits for doc lookups)
CONTEXT7_API_KEY="{{YOUR_CONTEXT7_API_KEY}}"
